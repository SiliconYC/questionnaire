{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siliconyc.github.io/questionnaire/contracts/experiment-config.schema.json",
  "title": "感官评价实验配置 1.0.0",
  "description": "结构校验契约。唯一标识、量程关系、步长、档位拼接和时间关系还需执行 docs/06 所规定的语义校验。$id 是标识符，不代表该地址已经发布。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment", "samples", "indicators", "text_questions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment": { "$ref": "#/$defs/experiment" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/sample" }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/indicator" }
    },
    "text_questions": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/text_question" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "score_number": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000,
      "description": "最多两位小数由第二层精确十进制校验保证；不使用浮点 multipleOf:0.01 判断。"
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "必须启用 date-time 格式校验，并要求明确的 Z 或时区偏移。"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "instructions", "time_zone", "opens_at", "closes_at", "display_sample_names", "design", "sample_order"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "instructions": { "type": "string", "maxLength": 4000 },
        "time_zone": { "const": "Asia/Shanghai" },
        "opens_at": { "$ref": "#/$defs/timestamp" },
        "closes_at": { "$ref": "#/$defs/timestamp" },
        "display_sample_names": { "type": "boolean" },
        "design": { "const": "within_subject_complete" },
        "sample_order": { "const": "fixed" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "code", "admin_name", "display_name"],
      "properties": {
        "sample_id": { "$ref": "#/$defs/id" },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "admin_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "display_name": { "type": "string", "maxLength": 100 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "from", "to"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "from": { "$ref": "#/$defs/score_number" },
        "to": { "$ref": "#/$defs/score_number" }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator_id", "category", "label", "description", "kind", "min", "max", "step", "required", "allow_not_evaluable", "direction", "analysis_scale", "anchors"],
      "properties": {
        "indicator_id": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1, "maxLength": 50 },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "kind": { "enum": ["continuous", "anchored"] },
        "min": { "$ref": "#/$defs/score_number" },
        "max": { "$ref": "#/$defs/score_number" },
        "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000, "description": "最多两位小数；精度与步长网格由第二层精确十进制校验保证。" },
        "required": { "type": "boolean" },
        "allow_not_evaluable": { "type": "boolean" },
        "direction": { "enum": ["higher_better", "lower_better", "neutral"] },
        "analysis_scale": { "enum": ["interval", "ordinal"] },
        "anchors": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/anchor" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "continuous" } }, "required": ["kind"] },
          "then": { "properties": { "anchors": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "anchored" } }, "required": ["kind"] },
          "then": { "properties": { "anchors": { "minItems": 2 } } }
        }
      ]
    },
    "text_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_question_id", "label", "description", "required", "max_length"],
      "properties": {
        "text_question_id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "required": { "type": "boolean" },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 2000 }
      }
    }
  }
}
